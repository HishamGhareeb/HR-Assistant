# Tenant isolation is enforced by namespacing every object ID with its
# tenant, not by relations in this model: "leave_record:acme__sarah_leave"
# and "leave_record:globex__sarah_leave" are unrelated objects to OpenFGA
# even if both tenants have an employee named "sarah". One shared
# store/model is used across tenants; the "<tenant_id>__<local_id>" object
# ID convention (built by glue.openfga_client.scoped_object_id) is what
# actually prevents cross-tenant collisions. Every tuple written by the
# RAL HRMS -> OpenFGA sync (department membership, ownership, hr_admin, ...)
# MUST use the same convention for both the record and any department it
# references, or a record silently becomes unreachable. See
# docs/OPENFGA_PROVISIONING.md.

model
  schema 1.1

type user

type tenant
  relations
    define employee: [user]
    define manager: [user]
    define hr_admin: [user]
    define system_admin: [user]

type department
  relations
    define member: [user]
    define manager: [user]

# Generic record types HR documents/data get tagged as when ingested.
# hr_admin and owner are assigned tuples; department membership grants
# manager-level visibility EXCEPT on salary_record, by design.

type employee_record
  relations
    define owner: [user]
    define department: [department]
    define hr_admin: [user]
    define viewer: owner or hr_admin or manager from department

type leave_record
  relations
    define owner: [user]
    define department: [department]
    define hr_admin: [user]
    define viewer: owner or hr_admin or manager from department

type performance_record
  relations
    define owner: [user]
    define department: [department]
    define hr_admin: [user]
    define viewer: owner or hr_admin or manager from department

# No "manager from department" here: managers see performance data for
# their reports, but never salary/compensation data. Only the owner and
# HR admins can view a salary_record.
type salary_record
  relations
    define owner: [user]
    define hr_admin: [user]
    define viewer: owner or hr_admin

# Policy documents are visible to every authenticated employee.
type policy_document
  relations
    define viewer: [user, user:*]
