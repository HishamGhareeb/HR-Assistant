ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
ONYX_API_URL=http://localhost:3002
ONYX_API_KEY=
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# Signed authentication (glue/auth.py) -- set exactly one key source.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
# Alternative to AUTH_JWKS_URL: {"<kid>": "<PEM public key>", ...}
AUTH_STATIC_KEYS_JSON=

# Audit (glue/audit.py) -- see docs/AUDIT_AND_OBSERVABILITY.md before
# rotating: rotating this key starts a new actor-pseudonym correlation
# epoch. Never commit a real value.
AUDIT_PRIVACY_KEY=
AUDIT_LOG_PATH=.tmp/audit.jsonl

# Browser-facing frontend (web/) -- empty by default (no CORS surface at
# all). Set to your dev server's origin to allow it cross-origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dev-only JWT minting (glue/dev_auth.py) so web/ can authenticate locally
# without a real identity provider. NEVER set DEV_AUTH_ENABLED in a real
# deployment. Generate these with scripts/generate_dev_auth_keypair.py --
# the printed public key must also be merged into AUTH_STATIC_KEYS_JSON
# above.
DEV_AUTH_ENABLED=false
DEV_AUTH_PRIVATE_KEY_PEM=
DEV_AUTH_KID=dev-key-1
DEV_AUTH_TOKEN_TTL_SECONDS=28800
